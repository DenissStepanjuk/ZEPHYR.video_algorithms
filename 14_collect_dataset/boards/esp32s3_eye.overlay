// west build -p always -b esp32s3_eye/esp32s3/procpu -- -DDTC_OVERLAY_FILE=boards/esp32s3_eye.overlay -DEXTRA_CONF_FILE=boards/esp32s3_eye.conf
// ---------------------------------------------------------------------------------------------------------------------------------------------

/* ----------------------|  Display  |---------------------  */
/* https://www.lcdwiki.com/4.0inch_SPI_Module_ST7796 */

// MIPI DBI (Display Bus Interface) - универсальный драйвер-адаптер для управления LCD-контроллерами через SPI.
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/* Узел chosen - Zephyr узел, который указывает какие устройства использовать в этом приложении. */
/ {
    	chosen {
		/* Свойство zephyr,display -  Ключ (property name) в формате vendor,property
			- vendor = zephyr (производитель/namespace)
			- property = display (сущность, которую описывает свойство)
		Присваивание значения - phandle (указатель на узел)
			- & - оператор взятия ссылки на узел
			- st7796s_320x480 - label (метка) другого узла в DTS */
        zephyr,display = &st7796s_320x480;

		/* Свойство zephyr,camera -  Ключ (property name) в формате vendor,property
			- vendor = zephyr (производитель/namespace)
			- property = camera (сущность, которую описывает свойство)
		Присваивание значения - phandle (указатель на узел)
			- & - оператор взятия ссылки на узел
			- lcd_cam_dvp - label (метка) другого узла в DTS */
		zephyr,camera = &lcd_cam_dvp;

		/* Свойство zephyr,touch - обязательно для sample draw_touch_events
		(README сэмпла явно требует, чтобы были заданы оба chosen: zephyr,display И zephyr,touch).
			- vendor = zephyr
			- property = touch
		Присваивание значения - phandle на узел xpt2046, объявленный ниже, внутри &spi3
		(отдельная от дисплея SPI-шина, см. пояснение у узла &spi3). */
		zephyr,touch = &xpt2046;
    	};


	/* Узел mipi_dbi реализует транспортный уровень между:
		- драйвером дисплейного контроллера ST7796S
		- SPI-контроллером ESP32
		- GPIO сигналами (DC, RESET) */
    	mipi_dbi {
		// Использовать драйвер mipi_dbi_spi
		compatible = "zephyr,mipi-dbi-spi";
		// Определить SPI контроллер через ссылку на узел spi2 в devicetree.
		spi-dev = <&spi2>;
		// Определить пин для переключения режима SPI передачи (DC (Data/Command)).
		dc-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;  // DC/RS pin
		// Определить пин для аппаратного reset дисплея.
        reset-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;   // RESET pin
		// Адрес устройства на шине занимает одну 32-битную ячейку.
		#address-cells = <1>;
		// Размер не задаётся (SPI-устройства не имеют диапазона адресов).
		#size-cells = <0>;

		/* Объявление узла st7796s_320x480 дисплея:
		- st7796s_320x480: - Label (метка) для этого узла, используется для ссылок.
		- st7796s@0 - Имя узла в формате name@unit-address
			+ st7796s - имя (произвольное, описательное)
			+ @ - разделитель
			+ 0 - unit address (адрес устройства на шине), взят из datasheet.*/
		st7796s_320x480: st7796s@0 {
			// Использовать драйвер дисплея "sitronix,st7796s".
			compatible = "sitronix,st7796s";
			// Включить устройство.
			status = "okay";
			// Адрес устройства на шине, взят из datasheet.
            		reg = <0>;
			// Максимальная тактовая частота SPI для дисплея.
			mipi-max-frequency = <20000000>;
			// 4 линии для SPI: CLK, MOSI, MISO, CS + отдельный DC пин.
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			// Ширина дисплея.
			width = <320>;
			// Высота дисплея.
			height = <480>;

			/* Регистр в контроллере дисплея через который задаются параметры:
			 * D7 - зеркалит по вертикали (Y).
			 * D6 - зеркалит по горизонтали (X).
			 * D5 - меняет X и Y местами (поворот на 90°).
			 * D4 - Направление обновления (сверху вниз или снизу вверх).
			 * D3 - Порядок цветов в памяти (RGB-BGR).
			 * D2 - Направление обновления по горизонтали.
			 * D1 - Не используется (Reserved).
			 * D0 - Не используется (Reserved).
			 * D7 D6 D5 D4 D3 D2 D1 D0
			 * 0  1  1  0  1  0  0  0  ==  104 (перевод из двоичной в десятичную)
			 * 1  1  0  0  1  0  0  0  ==  200 (перевод из двоичной в десятичную)*/
			// madctl = <104>;
			madctl = <72>;
			// madctl = <40>;

			// Настройка gamma curve для ярких цветов.
			//pgc = [00];
			pgc = [D0 06 0C 0E 09 0B 38 34 48 05 13 14 10 14];

			// Настройка gamma curve для тёмных цветов.
			//ngc = [00];
			ngc = [D0 01 06 0C 0C 0F 31 3F 47 0A 16 16 17 16];
		};
	};
};


/* Включаем wifi на плате. */
&wifi {
    status = "okay";
};

/* Переопределяем базовый узел spi2 описывающий SPI контроллер ТОЛЬКО для дисплея.
 * Тач-панель сюда больше НЕ подключаем - см. &spi3 ниже.
 *
 * ПОЧЕМУ: в драйвере ESP32 SPI (spi_esp32_spim.c) есть известный, подтверждённый
 * race condition при использовании нескольких программных cs-gpios на одной шине -
 * CS одного устройства не всегда корректно деактивируется перед транзакцией другого,
 * из-за чего оба чипа временно оказываются выбраны одновременно и конфликтуют на общей
 * линии MISO (мы поймали это осциллографом: CS дисплея дёргался во время транзакций
 * тача, а MISO не проваливался до 0В, а зависал на промежуточном уровне ~1.5В - явный
 * признак коллизии двух выходов на одной линии). См. github.com/zephyrproject-rtos/zephyr
 * issue #65635 ("SPI: ESP32: chip-select misbehaviour with multiple gpio-cs") и issue
 * #100069 (похожая проблема конкретно с mipi-dbi-spi на ESP32-S3). Самое надёжное
 * решение - развести устройства по разным аппаратным SPI-контроллерам (spi2/spi3),
 * а не делить один контроллер несколькими cs-gpios. */
&spi2 {
	// Адрес устройства на шине занимает одну 32-битную ячейку.
	#address-cells = <1>;
	// Размер не задаётся (SPI-устройства не имеют диапазона адресов).
	#size-cells = <0>;
	// Привязка к конфигурации пинов.
	pinctrl-0 = <&spi2_custom_pins>;
	pinctrl-names = "default";
	// Включить устройство.
    status = "okay";
	// Единственное устройство на шине - дисплей, поэтому один CS достаточно и
	// гонка между несколькими cs-gpios здесь в принципе невозможна.
	cs-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;   /* CS0: дисплей ST7796 (GPIO38, как и было изначально) */
};

/* Переопределяем конфигурацию пинов SPI2 (только дисплей). */
&pinctrl {
    spi2_custom_pins: spi2_custom_pins {
        group1 {
			pinmux = <SPIM2_MISO_GPIO47>,     // MISO pin (SDO on display)
				     <SPIM2_SCLK_GPIO42>;      // SCK pin
		};
		group2 {
			pinmux = <SPIM2_MOSI_GPIO41>;      // MOSI pin (SDI on display)
			output-low;
		};
    };
};

/* ----------------------|  TOUCH XPT2046 (отдельная шина SPI3)  |---------------------  */

/* Тач-панель посажена на ВТОРОЙ независимый аппаратный SPI-контроллер (spi3), а не
 * на spi2 вместе с дисплеем. Так как на этой шине только одно устройство, гонка между
 * несколькими cs-gpios (см. пояснение у &spi2 выше) физически невозможна - конфликтовать
 * попросту не с чем.
 *
 * ВНИМАНИЕ: T_CLK/T_DIN/T_DO нужно физически перепаять/перекинуть проводом с GPIO42/41/47
 * (где они были при разделяемой шине) на GPIO14/21/19 ниже. T_CS (GPIO2) и T_IRQ (GPIO1)
 * менять не нужно - осциллограф уже подтвердил, что они физически подключены верно и
 * работают (T_IRQ корректно падает при касании, T_CS корректно даёт короткий импульс).
 *
 * GPIO14 и GPIO21 - это обычные, не strapping GPIO на ESP32-S3, в этом проекте нигде
 * больше не заняты (камера/дисплей/PSRAM/Flash их не используют). GPIO19 - это, как
 * правило, вывод USB D- (native USB OTG); большинство CAM-плат на базе ESP32-S3-CAM
 * используют для прошивки/UART отдельный USB-UART мост (CP2102/CH340), а не native USB,
 * и тогда GPIO19/20 свободны - но это НУЖНО проверить по схеме именно вашей платы. Если
 * сомневаетесь - замените GPIO19 на любой другой проверенно свободный пин. */
&spi3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spi3_custom_pins>;
	pinctrl-names = "default";
	// Единственное устройство на шине - тач, поэтому один CS достаточно.
	cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;   /* CS0: тач-панель T_CS (GPIO2) */

	xpt2046: xpt2046@0 {
		// Драйвер xptek,xpt2046 (drivers/input/input_xpt2046.c)
		compatible = "xptek,xpt2046";
		// Единственное устройство на шине spi3 -> индекс 0 в cs-gpios.
		reg = <0>;
		// Макс. частота SPI для XPT2046 (датащит допускает до ~2 МГц-2.5МГц в этом режиме чтения).
		spi-max-frequency = <2000000>;
		// T_IRQ (PENIRQ) - открытый сток, активный низкий уровень при касании.
		int-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		// Логическое разрешение, в которое драйвер маппит "сырые" координаты АЦП.
		// Взято равным width/height дисплея (320x480), см. узел st7796s_320x480 выше.
		touchscreen-size-x = <320>;
		touchscreen-size-y = <480>;
		// Диапазон "сырых" значений АЦП XPT2046 (12-бит -> 0..4095).
		// Это стартовые значения "по датащиту" - реальный рабочий диапазон обычно уже
		// (например 200..3900) и может требовать инверсии/свопа осей в зависимости от
		// физической ориентации панели относительно madctl дисплея. Требуется калибровка
		// через сам сэмпл draw_touch_events (по нему легко увидеть инверсию/своп осей).
		// min-x = <0>;
		// min-y = <0>;
		// max-x = <4095>;
		// max-y = <4095>;
		min-x = <300>;
		min-y = <300>;
		max-x = <3900>;
		max-y = <3900>;
	};
};

&pinctrl {
	spi3_custom_pins: spi3_custom_pins {
		group1 {
			pinmux = <SPIM3_MISO_GPIO0>,       // T_DO  (было GPIO47, ПЕРЕПАЯТЬ - проверить свободен ли GPIO19)
				     <SPIM3_SCLK_GPIO14>;      // T_CLK (было GPIO42, ПЕРЕПАЯТЬ)
		};
		group2 {
			pinmux = <SPIM3_MOSI_GPIO21>;      // T_DIN (было GPIO41, ПЕРЕПАЯТЬ)
			output-low;
		};
	};
};

// Отключить дисплей предусмотренный по умолчанию.
&st7789v {
    status = "disabled";
};

/* ----------------------|  CAMERA OV2640  |---------------------  */


/* ESP32-S3 DVP-контроллер использует DMA для передачи пикселей с модуля камеры в PSRAM/SRAM микроконтроллера без участия CPU. */
&dma {
	// Включить устройство.
	status = "okay";
};

/* Переопределяем базовый узел i2c1 описывающий I2C контроллер для камеры. */
&i2c1 {
	// Включить устройство.
	status = "okay";
	// Частота работы I2C шины в Герцах. (I2C_BITRATE_FAST = 400000 (400 kHz (400,000 Hz)))
	clock-frequency = <I2C_BITRATE_FAST>; // <I2C_BITRATE_STANDARD>
	// Привязка к конфигурации пинов.
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";

	/* Объявление узла OV2640 камеры
		- ov2640: - Label (метка) для этого узла
		- ov2640@30 - Имя узла в формате name@unit-address
			+ ov2640 - имя (произвольное, описательное)
			+ @ - разделитель
			+ 30 - unit address (адрес устройства на шине), взят из datasheet для OV2640.*/
	ov2640: ov2640@30 {
		// Использовать драйвер камеры "sitronix,st7796s".
		compatible = "ovti,ov2640";
		// Адрес устройства на шине I2C, взят из datasheet для OV2640.
		reg = <0x30>;
		// Включить устройство.
		status = "okay";
		// Дополнительный контроль частоты, специфичное для OV2640 свойство.
		clock-rate-control = <0x80>;

		/* Узел port - Video Graph binding.
			- Специальная структура для описания видео-потоков, описывает соединения между видео-компонентами.*/
		port {
			/* Узел endpoint - точка подключения
				- ov2640_ep_out: - Label для endpoint (ep = endpoint, out = выходной (от камеры наружу))
				- endpoint - стандартное имя узла для Video Graph */
			ov2640_ep_out: endpoint {
				// Связь с другим endpoint, указывает на label endpoint на другой стороне соединения.
				remote-endpoint = <&dvp_ep_in>;
			};
		};
	};
};


/* Универсальный периферийный контроллер, который может работать в двух режимах:
 *  LCD mode  → управление дисплеями / CAM mode  → интерфейс камеры  */
&lcd_cam {
	// Включить устройство.
	status = "okay";
	// Привязка к конфигурации пинов (включает все пины камеры).
	pinctrl-0 = <&lcd_cam_default>;
	pinctrl-names = "default";
};

/* DCMI (Digital Camera Module Interface (аппаратный модуль для захвата видео, принимает параллельный поток от камеры))
 * DVP (Digital Video Port (параллельный интерфейс камеры))
	- &lcd_cam_dvp - ссылка на DCMI контроллер */
&lcd_cam_dvp {
	// Включить устройство.
	status = "okay";
	// Частота тактирования XCLK, подаваемая ESP32-S3 на вход камеры OV2640
	// cam-clk = <10000000>; // <8000000>
	cam-clk = <4000000>;
	// Указывает, что источником видеопотока для DVP является OV2640.
	source = <&ov2640>;

	/* Узел port - Video Graph binding.
		- Специальная структура для описания видео-потоков, описывает соединения между видео-компонентами. */
	port {
		/* Узел endpoint - точка подключения
			- dvp_ep_in: - Label для endpoint
			- endpoint - стандартное имя узла для Video Graph*/
		dvp_ep_in: endpoint {
			// Указывает на камеру: Данные от ov2640_ep_out поступают сюда
			remote-endpoint = <&ov2640_ep_out>;
			// Ширина шины данных, количество линий данных между камерой и DCMI (8-bit параллельная шина)
			bus-width = <8>;
			// Камера подает импульс в начале каждой горизонтальной линии пикселей (Полярность [<0> = low, <1> = high])
			hsync-active = <0>;
			// Камера подает импульс в начале каждого кадра (Полярность [<0> = low, <1> = high])
			vsync-active = <0>;
			// На каком фронте Pixel Clock захватывать данные ([<0> = falling edge, <1> = rising edge])
			pclk-sample = <1>;
		};
	};
};




/* Распиновка для устройств:

	ST7796S          →    ESP32-S3
	────────────────────────────────
	VCC     (3.3V!)  →    3V3
	GND              →    GND
	CS               →    GPIO38
	RESET            →    GPIO39
	DC/RS            →    GPIO40
	SDI (MOSI)       →    GPIO41
	SCK              →    GPIO42
	LED              →    3V3 (через резистор 150Ω)
	SDO (MISO)       →    GPIO47 (опционально)

	XPT2046 (touch)  →    ESP32-S3     (ОТДЕЛЬНАЯ шина SPI3, НЕ общая с дисплеем!)
	────────────────────────────────
	T_CLK            →    GPIO14  (ПЕРЕПАЯТЬ с GPIO42 - проверить, что пин свободен на вашей плате)
	T_CS             →    GPIO2   (не менять, уже подтверждено осциллографом)
	T_DIN            →    GPIO21  (ПЕРЕПАЯТЬ с GPIO41 - проверить, что пин свободен на вашей плате)
	T_DO             →    GPIO0  (ПЕРЕПАЯТЬ с GPIO47 - проверить, что не задействован под native USB)
	T_IRQ            →    GPIO1   (не менять, уже подтверждено осциллографом)

	ESP32S3 →   CAMERA
	────────────────────────
	GPIO4      →   CAM_SIOD
	GPIO5      →   CAM_SIOC
	GPIO6      →   CAM_VYSNC
	GPIO7      →   CAM_HREF
	GPIO15     →   CAM_XCLK
	GPIO16     →   CAM_Y9
	GPIO17     →   CAM_Y8
	GPIO18     →   CAM_Y7
	GPIO8      →   CAM_Y4
	GPIO9      →   CAM_Y3
	GPIO10     →   CAM_Y5
	GPIO11     →   CAM_Y2
	GPIO12     →   CAM_Y6
	GPIO13     →   CAM_PCLK
*/
